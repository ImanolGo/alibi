# Copy to .env and fill in. Never commit .env.
#
# Models live in config/models.yaml (the source of truth); this file holds only
# secrets and deployment settings.

# --- Provider keys: hosted APIs through LiteLLM (no local LLMs) ------------
# Chat *and* embeddings both run through OpenRouter by default (see
# config/models.yaml), so one key covers the whole game.
OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Budget ----------------------------------------------------------------
# Hard daily cap in USD. Calls that would exceed it raise BudgetExceededError.
ALIBI_DAILY_BUDGET_USD=2.0

# Per-request timeout in seconds; a hung provider connection is retried, never
# allowed to block an eval run. Large generations (a whole case) can take a
# while, so keep this generous — it is a backstop, not a latency budget.
ALIBI_REQUEST_TIMEOUT_S=180

# --- Observability ---------------------------------------------------------
# Arize Phoenix OTLP/HTTP endpoint (docker compose service "phoenix").
ALIBI_PHOENIX_ENDPOINT=http://localhost:6006/v1/traces

# --- Postgres (used from M2 on) --------------------------------------------
ALIBI_DATABASE_URL=postgresql+psycopg://alibi:alibi@localhost:5432/alibi
